+	if err := restarted.SetPolicy(ctx, 1, []byte(`{"deleteOnRead":false}`)); err != nil {
+		t.Fatal(err)
+	}
+	if err := restarted.Tick(ctx); err != nil {
+		t.Fatal(err)
