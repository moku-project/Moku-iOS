diff --git a/src/hotspot/os/posix/signals_posix.cpp b/src/hotspot/os/posix/signals_posix.cpp
index 0157d354f..e501225f5 100644
--- a/src/hotspot/os/posix/signals_posix.cpp
+++ b/src/hotspot/os/posix/signals_posix.cpp
@@ -589,6 +589,15 @@ int JVM_HANDLE_XXX_SIGNAL(int sig, siginfo_t* info,
   }
 #endif
 
+  // These asynchronous notifications do not need an instruction context.
+  // In particular, BSD Zero has no ucontext_get_pc implementation: a closed
+  // media socket must not turn SIGPIPE into a fatal ShouldNotCallThis().
+  // Preserve signal chaining, including handlers installed by an embedding VM.
+  if (sig == SIGPIPE || sig == SIGXFSZ) {
+    PosixSignals::chained_handler(sig, info, ucVoid);
+    return true;
+  }
+
   // Extract pc from context. Note that for certain signals and certain
   // architectures the pc in ucontext_t will point *after* the offending
   // instruction. In those cases, use siginfo si_addr instead.
@@ -605,12 +614,6 @@ int JVM_HANDLE_XXX_SIGNAL(int sig, siginfo_t* info,
     signal_was_handled = handle_safefetch(sig, pc, uc);
   }
 
-  // Ignore SIGPIPE and SIGXFSZ (4229104, 6499219).
-  if (!signal_was_handled &&
-      (sig == SIGPIPE || sig == SIGXFSZ)) {
-    PosixSignals::chained_handler(sig, info, ucVoid);
-    signal_was_handled = true; // unconditionally.
-  }
 
 #ifndef ZERO
   // Check for UD trap caused by NOP patching.
