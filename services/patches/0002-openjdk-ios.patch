@@ -297,7 +297,13 @@ ReservedSpace CodeMemoryReserver::reserve(size_t size,
                                  size,
                                  alignment,
                                  page_size,
+#if defined(ZERO) && defined(__IOS__)
+                                 // Zero stores interpreter metadata here, not machine code.
+                                 // iOS rejects writable executable mappings without JIT rights.
+                                 !ExecMem,
+#else
                                  ExecMem,
+#endif
                                  mtCode);
 }
 
